# Server Configuration
PORT=5001
NODE_ENV=development

# Rate Limiting (Requests per minute per source)
RATE_LIMIT_PER_MIN=10

# Retry & Exponential Backoff
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=10000

# Circuit Breaker Configuration
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=30000

# Queue & Worker Pool
WORKER_CONCURRENCY=2

# Cron Schedule (Standard 5-field cron syntax; e.g. every 5 minutes: */5 * * * *)
FETCH_CRON_SCHEDULE=*/5 * * * *

# Public Feed Data Sources
PRIMARY_SOURCE_URL=https://remoteok.com/api
SECONDARY_SOURCE_URL=https://weworkremotely.com/remote-jobs.rss

# Storage
DB_PATH=./pipeline.db
